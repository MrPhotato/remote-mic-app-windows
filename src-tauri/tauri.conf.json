{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote Coding",
  "version": "0.2.8",
  "identifier": "local.remote-coding.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:2430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "无线麦 SayAll Windows 版",
        "width": 1029,
        "height": 732,
        "minWidth": 1029,
        "minHeight": 732,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "MrPhotato",
    "category": "Productivity",
    "shortDescription": "小米蓝牙遥控器的 Windows 语音与 Codex 控制器",
    "longDescription": "使用小米蓝牙遥控器进行语音输入、编辑文本和控制 Codex。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Remote Coding"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2OEYyRTdEQkQwODQ5NUUKUldSZVNRaTlmUzZQTnNWRVBaTXVURmZVVDl3M2crRUJCUEtXV2hXK0Q2ZU1NUWhvaklHNDBqaUMK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "remote-coding"
}
